<Window x:Class="OFPlayer.Community.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:OFPlayer_WinUI.Views">
 <Grid x:Name="Root" Background="{ThemeResource OFPlayerSurfaceBrush}" SizeChanged="ShellSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.Clip><RectangleGeometry x:Name="ShellClip"/></Grid.Clip>
  <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Padding="4,0,144,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <Button x:Name="SidebarToggle" Width="40" Height="40" Padding="0" Style="{StaticResource QuietButtonStyle}" Click="ToggleSidebar" Loaded="TitleBarEntryChanged" SizeChanged="TitleBarEntryChanged"><FontIcon Glyph="&#xE700;" FontSize="16"/></Button>
    <Image Source="ms-appx:///Assets/AppLogo.png" Width="24" Height="24"/>
    <TextBlock Text="OFPlayer" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3"><TextBlock Text="Community" FontSize="11"/></Border>
   </StackPanel>
  </Grid>
  <Grid x:Name="SidebarSpace" Grid.Row="1" Width="224"/>
  <!-- Keep the pane at its open width during motion; one timeline drives layout and clipping. -->
  <Grid x:Name="SidebarViewport" Grid.Row="1" Grid.ColumnSpan="2" Width="224" HorizontalAlignment="Left">
   <Grid Width="224" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <views:SidebarModeSwitch x:Name="ModeSwitch" Margin="4,6,4,0" HorizontalAlignment="Left"/>
     <views:SourcePickerView x:Name="Sources" Margin="4,4,4,4" HorizontalAlignment="Left" Width="216"/>
    </StackPanel>
    <NavigationView x:Name="Navigation" Grid.Row="1" Width="224" PaneDisplayMode="Left" IsPaneOpen="True" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" OpenPaneLength="224" CompactPaneLength="48" SelectionChanged="NavigationChanged" ItemInvoked="NavigationInvoked">
     <NavigationView.Resources>
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
     </NavigationView.Resources>
    </NavigationView>
   </Grid>
  </Grid>
  <Border Grid.Row="1" Grid.Column="1" CornerRadius="12,0,0,0" Background="{ThemeResource OFPlayerContentSurfaceBrush}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="ContentBackdropLayer" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"><Border x:Name="ContentBackdropPrevious"/><Border x:Name="ContentBackdropCurrent"/></Grid>
    <StackPanel><InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="12,8,12,0"/>
      <InfoBar x:Name="MissingNotice" IsOpen="False" IsClosable="True" Severity="Warning" Margin="12,8,12,0"><InfoBar.ActionButton><Button Content="查看失效歌曲" Click="ReviewMissingClicked"/></InfoBar.ActionButton></InfoBar></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="0"/></Grid.ColumnDefinitions>
     <views:LibraryPageView x:Name="LibraryPage"/>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="28,20"><StackPanel x:Name="SettingsContent" Spacing="16" MaxWidth="920" HorizontalAlignment="Stretch"/></ScrollViewer>
     <Grid x:Name="VideoPage" Visibility="Collapsed" Padding="24,18" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="视频" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="添加文件" Click="AddVideoClicked"/><Button Content="全屏" Click="VideoFullScreenClicked"/></StackPanel></Grid>
      <MediaPlayerElement x:Name="VideoSurface" Grid.Row="1" AreTransportControlsEnabled="True" Stretch="Uniform"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="添加字幕" Click="AddSubtitleClicked"/><ComboBox x:Name="SubtitleTracks" Width="180" DisplayMemberPath="Name" SelectionChanged="SubtitleChanged"/><ComboBox x:Name="VideoRate" Width="100" SelectedIndex="2" SelectionChanged="VideoRateChanged"><x:Double>0.5</x:Double><x:Double>0.75</x:Double><x:Double>1</x:Double><x:Double>1.25</x:Double><x:Double>1.5</x:Double><x:Double>2</x:Double></ComboBox></StackPanel>
      <ListView x:Name="VideoFiles" Grid.Row="3" DisplayMemberPath="Name" DoubleTapped="VideoDoubleTapped"/>
     </Grid>
     <Border x:Name="InspectorHost" Grid.Column="1" Visibility="Collapsed"><views:TrackInspectorView x:Name="Inspector"/></Border>
    </Grid>
    <views:PlaybackBarView x:Name="PlaybackBar" Grid.Row="2"/>
   </Grid>
  </Border>
  <Grid x:Name="ImmersiveHost" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{ThemeResource OFPlayerContentSurfaceBrush}"/>
 </Grid>
</Window>
