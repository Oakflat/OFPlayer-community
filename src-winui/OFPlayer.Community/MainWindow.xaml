<Window x:Class="OFPlayer.Community.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:OFPlayer.Community">
 <Grid x:Name="Root" Background="{ThemeResource CommunityChrome}" KeyboardAcceleratorPlacementMode="Hidden">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Padding="18,0,140,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="ms-appx:///Assets/AppLogo.png" Width="24" Height="24"/><TextBlock Text="OFPlayer" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3"><TextBlock Text="Community" FontSize="11"/></Border></StackPanel>
  </Grid>
  <Grid x:Name="SidePane" Grid.Row="1" Padding="12,12,12,10" RowSpacing="14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="6"><ToggleButton x:Name="MusicMode" Content="音乐" IsChecked="True" Click="MusicClicked" Width="92"/><ToggleButton x:Name="VideoMode" Content="视频" Click="VideoClicked" Width="92"/></StackPanel>
   <ComboBox x:Name="Libraries" Grid.Row="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="LibraryChanged"/>
   <ListView x:Name="Collections" Grid.Row="2" DisplayMemberPath="Name" SelectionChanged="CollectionChanged" SelectionMode="Single"/>
   <StackPanel Grid.Row="3" Spacing="4"><Button Content="新建曲库" Click="CreateLibraryClicked" HorizontalAlignment="Stretch"/><Button Content="新建歌单" Click="CreatePlaylistClicked" HorizontalAlignment="Stretch"/><Button Content="设置与隐私" Click="SettingsClicked" HorizontalAlignment="Stretch"/></StackPanel>
  </Grid>
  <Border x:Name="PageSurface" Grid.Row="1" Grid.Column="1" Background="{ThemeResource CommunitySurface}" CornerRadius="12,0,0,0" Padding="24,18,24,0">
   <Grid x:Name="PageLayout" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="PageHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="所有歌曲" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Text="从本机添加喜欢的音乐" Opacity="0.6" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="LyricsButton" Content="歌词" Click="LyricsClicked"/><Button x:Name="AddFiles" Content="添加文件" Click="AddFilesClicked"/><Button x:Name="AddFolder" Content="添加文件夹" Click="AddFolderClicked"/><Button Content="播放全部" Click="PlayAllClicked" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Grid>
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational"/>
    <AutoSuggestBox x:Name="Search" Grid.Row="2" PlaceholderText="搜索歌曲、歌手或专辑" QueryIcon="Find" TextChanged="SearchChanged"/>
    <Grid Grid.Row="3">
     <Grid x:Name="MusicPage"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <ListView x:Name="Tracks" IsItemClickEnabled="False" SelectionMode="Extended" DoubleTapped="TrackDoubleTapped" Padding="0,0,10,16">
       <ListView.ItemTemplate><DataTemplate x:DataType="local:TrackRow"><Grid Padding="8,12" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8D6;" FontSize="18" Opacity="0.6"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist, Mode=OneWay}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Album, Mode=OneWay}" Opacity="0.6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding DurationText, Mode=OneWay}" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListView.ItemTemplate>
       <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="播放" Click="PlaySelectedClicked"/><MenuFlyoutItem Text="收藏 / 取消收藏" Click="FavoriteClicked"/><MenuFlyoutItem Text="添加到歌单…" Click="AddToPlaylistClicked"/><MenuFlyoutItem Text="从曲库移除" Click="RemoveTracksClicked"/></MenuFlyout></ListView.ContextFlyout>
      </ListView>
      <Border x:Name="LyricsPanel" Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="20,8,0,16"><StackPanel Spacing="14"><TextBlock Text="歌词" FontSize="16" FontWeight="SemiBold"/><ScrollViewer MaxHeight="650"><TextBlock x:Name="Lyrics" Text="播放歌曲后，在这里显示本地歌词。" TextWrapping="Wrap" Opacity="0.75" LineHeight="30"/></ScrollViewer></StackPanel></Border>
     </Grid>
     <Grid x:Name="VideoPage" Visibility="Collapsed" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/></Grid.RowDefinitions><MediaPlayerElement x:Name="VideoSurface" AreTransportControlsEnabled="False" Stretch="Uniform"/><StackPanel x:Name="VideoOptions" Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="添加字幕" Click="AddSubtitleClicked"/><ComboBox x:Name="SubtitleTracks" Width="180" SelectionChanged="SubtitleChanged"/><ComboBox x:Name="VideoRate" Width="100" SelectedIndex="2" SelectionChanged="VideoRateChanged"><x:Double>0.5</x:Double><x:Double>0.75</x:Double><x:Double>1</x:Double><x:Double>1.25</x:Double><x:Double>1.5</x:Double><x:Double>2</x:Double></ComboBox><Button Content="全屏" Click="FullScreenClicked"/></StackPanel><ListView x:Name="VideoFiles" Grid.Row="2" DisplayMemberPath="Name" DoubleTapped="VideoDoubleTapped"/></Grid>
    </Grid>
   </Grid>
  </Border>
  <Border x:Name="PlaybackFooter" Grid.Row="2" Grid.ColumnSpan="2" Background="{ThemeResource CommunitySurface}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="22,12">
   <Grid ColumnSpacing="22"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="NowTitle" Text="还没有播放内容" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="选择本地音乐或视频" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14"><Button Click="PreviousClicked" AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首"><FontIcon Glyph="&#xE892;" FontSize="16"/></Button><Button Click="PlayPauseClicked" AutomationProperties.Name="播放或暂停" ToolTipService.ToolTip="播放 / 暂停"><FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="18"/></Button><Button Click="NextClicked" AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首"><FontIcon Glyph="&#xE893;" FontSize="16"/></Button></StackPanel><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionText" Text="0:00" FontSize="11" VerticalAlignment="Center" Opacity="0.6"/><Slider x:Name="Timeline" AutomationProperties.Name="播放进度" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="TimelineChanged"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.6"/></Grid></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE767;" FontSize="16"/><Slider x:Name="Volume" AutomationProperties.Name="音量" Minimum="0" Maximum="100" Value="50" Width="110" ValueChanged="VolumeChanged"/></StackPanel></Grid>
  </Border>
 </Grid>
</Window>
