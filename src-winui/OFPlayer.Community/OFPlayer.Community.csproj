<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OFPlayer.Community</RootNamespace>
    <Product>OFPlayer Community</Product>
    <Version>0.0.0-dev</Version>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CommunityNativeProfile Condition="'$(Configuration)' == 'Release'">release</CommunityNativeProfile>
    <CommunityNativeProfile Condition="'$(CommunityNativeProfile)' == ''">debug</CommunityNativeProfile>
    <CommunityNativeHost Condition="'$(CommunityNativeHost)' == ''">$(CommunityBuildRoot)\native\$(CommunityNativeProfile)\ofplayer-community-host.exe</CommunityNativeHost>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.12" />
    <ProjectReference Include="..\OFPlayer.WindowsMedia\OFPlayer.WindowsMedia.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250829.1" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(CommunityNativeHost)" Link="ofplayer-community-host.exe" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="..\OFPlayer.WindowsMedia\Native\ThirdParty\*-LICENSE.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyCommunityHost" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(CommunityNativeHost)')" Text="Build the Community native host from this checkout before building WinUI." />
  </Target>
</Project>
