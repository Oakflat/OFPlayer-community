<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OFPlayer_WinUI.Views.SourcePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The icon column matches the navigation items below (40 wide, glyph centred),
         so the library icon lines up with them in both the open and compact pane. -->
    <Button x:Name="PickerButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Padding="0" MinHeight="48" Style="{StaticResource QuietButtonStyle}" Click="OpenPicker">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="SourceIcon" Glyph="&#xE8B7;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel x:Name="LabelPanel" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="LibraryText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="IdentityText" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <FontIcon x:Name="Chevron" Grid.Column="2" Margin="8,0,12,0" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Button>
</UserControl>
