<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="OFPlayer_WinUI.Views.StorageAnalysisDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" CloseButtonText="" DefaultButton="Close" Style="{StaticResource OFPlayerDialogStyle}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
  </ContentDialog.Resources>
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
    <StackPanel x:Name="Body" Spacing="24" Margin="0,0,24,8">
      <TextBlock x:Name="LocaleLabel1" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Visibility="Collapsed" />
      <InfoBar x:Name="Notice" IsClosable="False" />
      <StackPanel x:Name="Results" Spacing="24" Visibility="Collapsed">
        <Grid ColumnSpacing="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6">
            <TextBlock x:Name="Total" FontSize="44" FontWeight="SemiBold" />
            <TextBlock x:Name="LocaleLabel2" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
            <TextBlock x:Name="Reclaimable" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="LocaleLabel3" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>
        <Grid x:Name="UsageStrip" Height="10" ColumnSpacing="3" />
        <StackPanel x:Name="Categories" Spacing="16" />
        <TextBlock x:Name="LocaleLabel4" Text="" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border Padding="20" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
          <StackPanel Spacing="12">
            <TextBlock x:Name="LocaleLabel5" Text="" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="LocaleLabel6" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="Cleanup" Content="" Click="ReviewCleanup" HorizontalAlignment="Left" />
            <TextBlock x:Name="CleanupHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="Confirmation" Spacing="12" Visibility="Collapsed">
              <TextBlock x:Name="LocaleLabel7" Text="" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="LocaleLabel8" Content="" Click="ConfirmCleanup" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="LocaleLabel9" Content="" Click="CancelCleanup" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <Button x:Name="Refresh" Content="" Click="RefreshClicked" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
