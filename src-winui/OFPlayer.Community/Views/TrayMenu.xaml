<?xml version="1.0" encoding="utf-8"?>
<!-- The tray icon's menu, in three parts: the app and its lyric capsule, what is playing with its
     controls, and quitting. It sits on the window's own acrylic, so nothing here has a background
     until it is pointed at. Every string comes from the string table. -->
<UserControl x:Class="OFPlayer_WinUI.Views.TrayMenu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="MenuKeyDown">
  <UserControl.Resources>
    <ResourceDictionary>
      <!-- Pointed at, an item takes the faint fill of the system's menus rather than a button's;
           an unavailable one keeps no box at all. High contrast keeps the system's own. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#09000000" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#06000000" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast" />
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="Item" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style x:Key="Control" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="-4,4" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel MinWidth="264" MaxWidth="320" Padding="4,8" XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Cycle">
    <Button x:Name="OpenItem" Style="{StaticResource Item}" Click="OpenClick">
      <TextBlock x:Name="OpenLabel" />
    </Button>
    <Button x:Name="CapsuleItem" Style="{StaticResource Item}" Click="CapsuleClick">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="CapsuleLabel" TextTrimming="CharacterEllipsis" />
        <FontIcon x:Name="CapsuleCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="12" />
      </Grid>
    </Button>

    <Border Style="{StaticResource Divider}" />
    <Grid Padding="12,4,0,4" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="NowTitle" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="NowArtist" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PreviousItem" Style="{StaticResource Control}" Click="PreviousClick"><FontIcon Glyph="&#xE892;" FontSize="14" /></Button>
        <Button x:Name="PlayItem" Style="{StaticResource Control}" Click="PlayClick"><FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="16" /></Button>
        <Button x:Name="NextItem" Style="{StaticResource Control}" Click="NextClick"><FontIcon Glyph="&#xE893;" FontSize="14" /></Button>
      </StackPanel>
    </Grid>

    <Border Style="{StaticResource Divider}" />
    <Button x:Name="ExitItem" Style="{StaticResource Item}" Click="ExitClick">
      <TextBlock x:Name="ExitLabel" />
    </Button>
  </StackPanel>
</UserControl>
