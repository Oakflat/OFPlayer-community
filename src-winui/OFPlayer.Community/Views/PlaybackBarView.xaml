<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OFPlayer_WinUI.Views.PlaybackBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OFPlayer_WinUI.Views">
    <!-- What is playing (left), transport (centre), tools for the playing track
         (right). Tools that do not fit a narrow bar move into the More menu. -->
    <Grid
        x:Name="BarRoot"
        Background="{ThemeResource OFPlayerPlaybackSurfaceBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        Padding="24,8,24,4"
        ColumnSpacing="12"
        RowSpacing="4"
        SizeChanged="BarSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="120"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
          <Grid x:Name="PreviousTrack" ColumnSpacing="12" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Image x:Name="PreviousArt" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="PreviousLabel" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PreviousSub" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
          <!-- The playing song is the way to its details; no separate button repeats it. -->
          <Grid x:Name="CurrentTrack" ColumnSpacing="12" Background="Transparent" Tapped="NowPlayingTapped">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Grid>
                    <FontIcon Glyph="&#xE8D6;" FontSize="18" Opacity="0.4" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Image x:Name="NowArt" Stretch="UniformToFill"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="NowLabel" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NowSub" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="PlayModeButton" Style="{StaticResource QuietButtonStyle}" Click="CyclePlayMode"><FontIcon x:Name="PlayModeIcon" Glyph="&#xE8EE;" FontSize="16"/></Button>
            <Button x:Name="PreviousButton" Style="{StaticResource QuietButtonStyle}" Click="PlayPrevious">
                <FontIcon Glyph="&#xE892;" FontSize="14"/>
            </Button>
            <Button x:Name="PlayButton" Click="TogglePlayback" Width="44" Height="44" Padding="0" CornerRadius="22" Style="{StaticResource AccentButtonStyle}">
                <SymbolIcon Symbol="Play"/>
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource QuietButtonStyle}" Click="PlayNext">
                <FontIcon Glyph="&#xE893;" FontSize="14"/>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="LyricsButton" Style="{StaticResource QuietButtonStyle}" Click="ToggleLyrics"><FontIcon x:Name="LyricsIcon" Glyph="&#xED1E;" FontSize="16"/></Button>
            <Button x:Name="QueueButton" Style="{StaticResource QuietButtonStyle}" Click="RequestQueue"><FontIcon Glyph="&#xE8FD;" FontSize="16"/></Button>
            <!-- Volume and the output device are one decision about where the sound goes, so the device
                 is chosen inside the volume panel. Song details open from the playing song itself. -->
            <Button x:Name="VolumeButton" Style="{StaticResource QuietButtonStyle}">
                <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16"/>
                <Button.Flyout><Flyout><StackPanel Spacing="8" Width="220"><TextBlock x:Name="VolumeLabel"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80"
                        ValueChanged="VolumeChanged"/>
                    <Button x:Name="DeviceButton" Style="{StaticResource QuietButtonStyle}" Click="OpenDevices"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="-8,0,-8,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F5;" FontSize="14"/>
                            <TextBlock x:Name="DeviceLabel" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Button>
                </StackPanel></Flyout></Button.Flyout>
            </Button>
            <Button x:Name="ImmersiveButton" Style="{StaticResource QuietButtonStyle}" Click="RequestImmersive"><FontIcon Glyph="&#xE740;" FontSize="16"/></Button>
            <Button x:Name="BarMoreButton" Style="{StaticResource QuietButtonStyle}" Click="OpenMoreMenu"><FontIcon Glyph="&#xE712;" FontSize="16"/></Button>
        </StackPanel>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PositionText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" Text="0:00 / 0:00"/>
            <!-- Layers, bottom up: the unbuffered track and the real cached ranges are drawn
                 here, matched to the slider's own track; the slider draws what has played
                 and the thumb above them. -->
            <Grid Grid.Column="1" SizeChanged="CacheTrackSizeChanged">
            <Canvas x:Name="CachedTrack" IsHitTestVisible="False"/>
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center"
                    StepFrequency="0.1"
                    ValueChanged="SeekChanged">
                <Slider.Resources>
                    <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent"/>
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent"/>
                </Slider.Resources>
            </Slider>
            </Grid>
            <ProgressRing x:Name="BufferingRing" Grid.Column="2" Width="14" Height="14" IsActive="False"/>
            <!-- A shared room keeps this line for the whole session, so recovering never
                 moves the bar: it says what the audio is doing, or names the cached shade. -->
            <Grid x:Name="BufferStatusRow" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="18"
                  HorizontalAlignment="Right" Visibility="Collapsed">
                <Grid x:Name="BufferStatusLine" ColumnSpacing="6" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CacheLegendSwatch" Width="12" Height="4" CornerRadius="2" VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.45" Visibility="Collapsed"/>
                    <!-- Its colour comes from code (WindowTheme), which a value set here would override. -->
                    <TextBlock x:Name="BufferStatus" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"/>
                    <HyperlinkButton x:Name="BufferRetry" Grid.Column="2" FontSize="11" Padding="4,0" MinHeight="0"
                                     VerticalAlignment="Center" Visibility="Collapsed" Click="RetryBuffering"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
