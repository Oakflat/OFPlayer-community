<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OFPlayer.Community.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OFPlayer_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Chrome tint reveals the native desktop Acrylic; reading surfaces stay solid. The
                 sheet is the reading surface laid inside a chrome page (the track list); it
                 steps aside over a content background, so the background shows evenly. The
                 playback bar is in-app glass: the song list scrolls on under it, softened. Its
                 tint here matches the default clarity; Settings › Appearance adjusts it. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="OFPlayerSurfaceBrush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="OFPlayerContentSurfaceBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="OFPlayerSheetSurfaceBrush" Color="#202020"/>
                    <AcrylicBrush x:Key="OFPlayerPlaybackSurfaceBrush" TintColor="#202020" TintOpacity="0.38" TintLuminosityOpacity="0.54" FallbackColor="#202020"/>
                    <SolidColorBrush x:Key="OFPlayerChromeSurfaceBrush" Color="#E6202020"/>
                    <!-- The account ring and allowance meters: bright fixed colours on a hairline,
                         dark ticks and a meter track that follow the theme. Warnings in text use
                         the deeper shades, which stay readable on the menu. -->
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OFPlayerSurfaceBrush" Color="#66FFFFFF"/>
                    <SolidColorBrush x:Key="OFPlayerContentSurfaceBrush" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="OFPlayerSheetSurfaceBrush" Color="#FAFAFA"/>
                    <AcrylicBrush x:Key="OFPlayerPlaybackSurfaceBrush" TintColor="#FAFAFA" TintOpacity="0.38" TintLuminosityOpacity="0.54" FallbackColor="#FAFAFA"/>
                    <SolidColorBrush x:Key="OFPlayerChromeSurfaceBrush" Color="#EDFAFAFA"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="OFPlayerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="OFPlayerContentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="OFPlayerSheetSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="OFPlayerPlaybackSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="OFPlayerChromeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
            <Style x:Key="OFPlayerDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="local:DialogCornerRadiusSync.Radius" Value="16"/>
                <!-- A dialog is not inside the window's root, so it would not see the theme chosen in Settings. -->
                <Setter Property="local:WindowTheme.FollowsWindow" Value="True"/>
            </Style>
            <Style TargetType="ContentDialog" BasedOn="{StaticResource OFPlayerDialogStyle}"/>
            <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
