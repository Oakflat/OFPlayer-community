{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFPlayer Community",
  "version": "26.0.4",
  "identifier": "org.ofplayer.community",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:15573",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OFPlayer",
        "width": 1440,
        "height": 900,
        "minWidth": 1160,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/ofplayer/track-artwork/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
